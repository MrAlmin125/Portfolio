# =========================================================
# PERFORMANCE — COMPRESSION
# =========================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# =========================================================
# PERFORMANCE — BROWSER CACHING
# =========================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg    "access plus 1 year"
  ExpiresByType image/jpeg   "access plus 1 year"
  ExpiresByType image/png    "access plus 1 year"
  ExpiresByType image/webp   "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css     "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html    "access plus 0 seconds"
</IfModule>

# =========================================================
# SECURITY
# =========================================================

Options -Indexes

RewriteEngine On


# =========================================================
# CUSTOM ERROR PAGES
# =========================================================

# Any wrong / non-existing URL
ErrorDocument 404 /403.html

# Any forbidden / protected request
ErrorDocument 403 /403.html


# =========================================================
# BLOCK SENSITIVE FILES
# =========================================================

<FilesMatch "^(?:config\.php|schema\.sql)$">
    Require all denied
</FilesMatch>


# =========================================================
# BLOCK SENSITIVE DIRECTORIES
# =========================================================

RewriteRule ^(?:config|includes|private|storage|logs|backups?)(?:/|$) - [F,L]


# =========================================================
# BLOCK API INTERNAL FILES
# =========================================================

RewriteRule ^api/(?:db|auth|config|connection|database)(?:\.php)?$ - [F,L]


# =========================================================
# BLOCK BACKUP / SOURCE FILES
# =========================================================

<FilesMatch "\.(?:bak|backup|old|orig|save|swp|tmp|log|sql)$">
    Require all denied
</FilesMatch>


# =========================================================
# BLOCK HIDDEN FILES
# =========================================================

RewriteRule (^|/)\. - [F,L]
